<div class="ontario-row maincontent__container">
    <div class="ontario-column ontario-small-12">
        <form name="searchForm" id="search-example-2-form" class="ontario-search__container" novalidate>
            <h5>Find programs and services</h5>
            <p style="font-size:15px; padding-bottom:5px;" id="search-example-2-hint" class="ontario-hint">Enter a topic like "power of attorney" or "driver's licence."</p>
            <div class="ontario-search-input__container">
                <input type="text" name="q" id="search-text" class="ontario-input" x-model:value="searchTerm" x-on:keyup.enter="updateURLParams()" />
                <input class="ontario-search__reset" id="ontario-search-reset" type="reset" value="" aria-label="Clear field" x-on:click="clearSearchFilters()" x-show="searchTerm.length > 0"/>
                <button class="ontario-search__submit" id="ontario-search-submit" type="submit" x-on:click="updateURLParams()">
                    <span class="ontario-show-for-sr">Submit</span>
                    <svg class="ontario-icon" focusable="false" sol:category="primary" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet">
                        <use xlink:href="#ontario-icon-search"></use>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>


<script>
    // Function to encode search parameters into the URL
    function encodeSearchParams(searchTerm, categories) {
        const params = new URLSearchParams();
        if (searchTerm) {
            params.append('q', searchTerm);
        }
        if (categories.length > 0) {
            params.append('categories', categories.join(','));
        }
        return params.toString();
    }

    // Function to decode search parameters from the URL
    function decodeSearchParams() {
        const params = new URLSearchParams(window.location.search);
        const searchTerm = params.get('q') || '';
        const categories = params.getAll('categories');
        return { searchTerm, categories };
    }

    // Create a searchPersistence module
    const searchPersistence = {
        encodeToUrl(searchTerm, categories) {
            const params = new URLSearchParams();

            if (searchTerm) {
                params.append('q', searchTerm);
            }

            if (categories.length > 0) {
                params.append('categories', categories.join(','));
            }

            const newUrl = `${window.location.pathname}?${params.toString()}`;

            history.pushState({}, '', newUrl);
        },
        decodeFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const searchTerm = params.get('q') || '';
            const categories = params.getAll('categories');
            return { searchTerm, categories };
        },
    };

    document.addEventListener('alpine:init', () => {
        Alpine.data('search', () => ({
            searchTerm: '',
            results: [],
            categorySearch: false,
            categoryCheckboxes: {},
            categories: [],
            doSearch() {
                // console log to check for errors
                console.log('Search Term:', this.searchTerm);
                console.log('Selected Categories:', this.categories);

                // Main search logic
                let data = {{ app.progamsServicesFromCSV.seniorsContent | dump | safe }};
                let options = {
                    keys: ['Resource title', 'Resource Description', 'Resource URL', 'Internal/External', 'Category', 'Sub Category'],
                    includeScore: true
                };
                let fuse = new Fuse(data, options);

                this.categories = Object.entries(this.categoryCheckboxes)
                    .map(([k,v]) => v ? k : undefined)
                    .filter(v => v);

                let results = fuse
                    .search(this.searchTerm)
                    .map(res => res.item);

                if (this.categories.length) {
                    this.categorySearch = true;
                    if (!this.searchTerm) {
                        // User has selected a category, but not entered a search term. 
                        results = data;
                    }
                    results = results.filter(result => this.categories.includes(result['Category']));
                } else {
                    this.categorySearch = false;
                }

                this.results = results;

                // Convert the Proxy object to a regular array
                this.results = Array.from(this.results);

                // log results
                console.log('Search Results:', this.results);
            },
            clearSearchFilters() {
                this.searchTerm = '';
                this.results = [];
            },

            updateURLParams() {
                // Encode the search to the URL
                searchPersistence.encodeToUrl(this.searchTerm, this.categories);

                const params = encodeSearchParams(this.searchTerm, this.categories);
                console.log('Encoded URL Params:', params);
                history.pushState({}, '', window.location.pathname + '?' + params);
                this.doSearch();
            },

            filteredResultsForCategory(category) {
                const count = this.results.reduce((acc, result) => {
                    return result['Category'] === category ? acc + 1 : acc;
                }, 0);

                if (count === 1){ 
                    return `${count} result from ${category}`;
                } else {
                    return `${count} results from ${category}`;
                }
            }
        }));
    });
</script>
