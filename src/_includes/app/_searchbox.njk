<div class="ontario-row maincontent__container">
    <div class="ontario-column ontario-small-12">
        <form name="searchForm" id="search-example-2-form" onsubmit="return false" class="ontario-search__container" novalidate>
            <label class="ontario-label ontario-search__label" for="search-example-2">Find Programs and Services</label>
            <p style="font-size:16px" id="search-example-2-hint" class="ontario-hint">Search for programs and services from the government and government-funded partners.</p>
            <div class="ontario-search-input__container">
                <input class="ontario-input" id="search-text" type="text" x-model:value="searchTerm" x-bind:placeholder="placeholder" x-on:keyup.enter="doSearch()" />
                <input class="ontario-search__reset" id="ontario-search-reset" type="reset" value="" aria-label="Clear field" x-on:click="clearSearchFilters()" x-show="searchTerm.length > 0"/>
                <button class="ontario-search__submit" id="ontario-search-submit" type="submit" x-on:click="doSearch()">
                    <span class="ontario-show-for-sr">Submit</span>
                    <svg class="ontario-icon" focusable="false" sol:category="primary" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet">
                        <use xlink:href="#ontario-icon-search"></use>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>


<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('search', () => ({
            searchTerm: '',
            results: [],
            placeholder: '{{ "searchbox.placeholder" | localeString }}',
            categoryCheckboxes: {},
            doSearch() {
                let data = {{ app.progamsServicesFromCSV.seniorsContent | dump | safe }};
                let options = {
                    keys: ['Resource title', 'Resource Description', 'Resource URL', 'Internal/External', 'Category', 'Sub Category'],
                    includeScore: true
                };
                let fuse = new Fuse(data, options);

                let categories = Object.entries(this.categoryCheckboxes)
                        .map(([k,v]) => v ? k : undefined)
                        .filter(v => v);

                let results = fuse
                        .search(this.searchTerm)
                        .map(res => res.item);

                if (categories.length) {
                    if (!this.searchTerm ) {
                        // User has selected a category, but not entered a search term. 
                        results = data;
                    }
                    results = results.filter(result => categories.includes(result['Category']));
                }

                this.results = results;
            },
            clearSearchFilters() {
                this.searchTerm = '';
                this.results = [];
            },
            filteredResultsForCategory(category) {
                const count = this.results.reduce((acc, result) => {
                    return result['Category'] === category ? acc + 1 : acc;
                }, 0);
                return `${count} results for ${category}`;
            }
        }));
    });
</script>

