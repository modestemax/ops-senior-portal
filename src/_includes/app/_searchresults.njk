<div class="ontario-column">
    <template x-if="!lastSearchTerm && !results.length">
        <div class="empty-search">
            <h3>{{"searchResults.emptyResult" | localeString}}</h3>
        </div>
    </template>
    <template x-if="lastSearchTerm && !results.length">
        <div class="no-results">
            <h2>
            {{"searchResults.noResult1" | localeString}}
            &quot;<span x-text="lastSearchTerm"></span>&quot;
            </h2>
            <p>{{"searchResults.noResult2" | localeString}}</p>
            <h3 class="ontario-h3">{{"searchResults.noResult3" | localeString}}</h3>
            <ul class="two-column-list">
                {%for category in filterCategories %}
                    <li>
                    {% if lang === "en" %}
                        <a :href="'/information-for-seniors-find-programs-and-services/?category=' + encodeURIComponent('{{category}}').replace(/%20/g, '+')" class="no-result-links">{{category}}</a>
                    {% elif lang === "fr" %}
                        <a :href="'/renseignements-lintention-des-personnes-agees-recherche-de-programmes-et-de-services/?category=' + encodeURIComponent('{{category}}').replace(/%20/g, '+')" class="no-result-links">{{category}}</a>
                    {% endif %}
                    </li>
                {%endfor%}
            </ul>
        </div>
    </template>
    <div class="total-results">
        <template x-if="lastSearchTerm === '' && results.length > 0">
            <h2>
            <span x-text="results.length + ' '"></span>
            {{"searchResults.totalResultsNoSearchterm" | localeString}}</h2>
        </template>
        <template x-if="lastSearchTerm !== '' && results.length === 1">
            <h2>
            <span x-text="results.length + ' '"></span>
            {{ "searchResults.totalResult" | localeString }}  
            &quot;<span x-text="lastSearchTerm"></span>&quot;
            </h2>
        </template>
        <template x-if="lastSearchTerm !== '' && results.length > 1">
            <h2>
            <span x-text="results.length + ' '"></span>
            {{ "searchResults.totalResults" | localeString }}  
            &quot;<span x-text="lastSearchTerm"></span>&quot;
            </h2>
        </template>
        <br>
        <div>
            <template x-for="result in results">
                <div style =" margin-bottom:48px;">
                    <div class="result-item">
                        <a style="text-decoration:none;" x-bind:href="result['Resource URL']">
                            <h3 class="ontario-h4"><strong x-text="result['Resource title']"></strong></h3>
                        </a>
                    </div>
                    <template x-if="result['Internal/External'] === 'External'">
                        <div class="external-link">
                            <a x-bind:href="result['Resource URL']" class="truncate" x-text="result['Resource URL']"></a>
                        </div>
                    </template>
                    <div style="font-size:16px" x-html="result['Resource Description']"></div>
                </div>
            </template>
        </div>
    </div>
</div>
