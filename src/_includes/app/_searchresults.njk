<div class="ontario-column ontario-small-12">
    <div x-show="results.length === 0 && lastSearchTerm">
            <div class="no-results">
                <template x-if="!categories.length" >
                    <h3>No results found for "<span x-text="lastSearchTerm"></span>"</h3>
                </template>
                <template x-if="categories.length">
                    <h3>No results found</h3>
                </template>
                <p>Try another keyword or adjust the filter.</p>
                <h4>Find programs and services by category</h4>
                <ul class="two-column-list">
                    <template x-for="category in ['Home and housing','Health and well-being','Caregiving','Recreation',
                            'Safety and security','Finances','Employment and learning','Driving and transportation']">
                        <li>
                            <a class="no-result-links" x-on:click="categoryClicked(category)" x-text="category">
                            </a>
                        </li>
                    </template>
                </ul>
            </div>
    </div>
    <div class="total-results">
        <template x-if="lastSearchTerm === ''">
            <template x-if="results.length > 0">
                <h2 x-text="results.length + ' ' + (results.length === 1 ? 'result' : 'total results') "></h2>
            </template>
        </template>
        <template x-if="!(lastSearchTerm === '')">
            <template x-if="results.length > 0">
                <h2 x-text="results.length + ' ' + (results.length === 1 ? 'result' : 'total results') + ' for &quot;' + lastSearchTerm  + '&quot;' "></h2>
            </template>
        </template>
        <br>
        <div>
            <template x-for="result in results">
                <div>
                    <div class="result-item">
                        <a style="text-decoration:none; font-size: 24px" x-bind:href="result['Resource URL']">
                            <strong x-text="result['Resource title']"></strong>
                        </a>
                        <template x-if="result['Internal/External'] === 'External'">
                            <a class="new-window" x-bind:href="result['Resource URL']"></a>
                        </template>
                        <hr>
                    </div>
                    <div style="font-size:16px" x-html="result['Resource Description']"></div>
                </div>
            </template>
        </div>
    </div>
</div>
