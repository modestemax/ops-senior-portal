{% set page_lang = "en" %}
{% if lang %}
    {% set page_lang = lang %}
{% endif %}
<div class="ontario-row maincontent__container ontario-padding-top-48-!">
    <div class="ontario-column ontario-small-12">
        <h2>{{ 'seniors.programsAndServicesComponent.title' | localeString }}</h2>
    </div>
</div>
<div class="ontario-row maincontent__container ontario-padding-top-24-!">
    <div class="ontario-column ontario-medium-5 ontario-large-4">
        <div class="ontario-form-group">
            <fieldset class="ontario-fieldset">
                <legend class="ontario-fieldset__legend">{{ 'seniors.programsAndServicesComponent.filter' | localeString }}</legend>
                <div class="ontario-checkboxes">
                    <!-- filters -->
                    {% for itemKey, filterItem in app["search-progams-and-services"].filters %}
                    <div class="ontario-checkboxes__item">
                        <input class="ontario-checkboxes__input" id="{{ itemKey }}" name="options" type="checkbox" value="{{ filterItem.value[ page_lang ] }}">
                        <label class="ontario-checkboxes__label" for="{{ itemKey }}">{{ filterItem.text[ page_lang ] }}</label>
                    </div>
                    {% endfor %}
                    <!-- / filters -->
                </div>
            </fieldset>
            <div class="ontario-row ontario-padding-top-32-!">
                <div class="ontario-column ontario-small-6">
                    <button class="ontario-button ontario-button--primary">{{ 'buttons.applyFilter' | localeString }}</button>
                </div>
                <div class="ontario-column ontario-small-6">
                    <button class="ontario-button ontario-button--tertiary">{{ 'buttons.clearFilters' | localeString }}</button>
                </div>
            </div>
        </div>
    </div>
    <div class="ontario-column ontario-medium-7 ontario-large-8">
        <div id="search-progams-and-services" name="search-progams-and-services">
            <!-- default content -->
            {{ 'seniors.programsAndServicesComponent.content' | localeString | safe }}
            <h3>{{ 'seniors.programsAndServicesComponent.topResources' | localeString }}</h3>
            <ul>
            {% for itemKey, resourceItem in app["top-resource-links"].resources %}
                <li><a href="{{ resourceItem.url[ page_lang ] }}">{{ resourceItem.text[ page_lang ] }}</a></li>
            {% endfor %}
            </ul>
            <!-- / default content -->
        </div>
    </div>
</div>