{% set page_lang = "en" %}
{% if lang %}
    {% set page_lang = lang %}
{% endif %}

<!-- Be sure all bound markup that need to share Alpine data and behaviour are within a single x-data scope -->
<!-- Otherwise, each one will be a new instance of the component, and they won't share their data -->
<!-- In this case, there were multiple `x-data=search` attributes, meaning there were multiple
components with their own independent data -->
<!-- This meant the search data from the search box wasn't being shared with the search results component, and vice-versa -->
<!-- The fix below puts everything in a single scope so they share data  -->

<div x-data="search" x-effect="updateCategorySelection()">
    <div class="ontario-row maincontent__container ontario-padding-top-48-!">
        <div class="ontario-column ontario-small-12">
            <div class="header-text">
                <h1> Information for seniors: find programs and services</h1>
                <p class="lead ontario-lead-statement">
                    Use the search tool to find programs and services from the government and government-funded partners.<br>
                    {% if ontarioca_breadcrumbs | length > 0 %}
                       Learn more about
                        <a href="{{ ontarioca_breadcrumbs | last | last }}">{{ "information for seniors" }}</a>.
                    {% endif %}
                </p>
            </div>

            <div class="ontario-padding-bottom-20-! ontario-padding-top-20-!">
                <hr class="bold">
            </div>
            <div class="ontario-column ontario-small-12 ontario-large-8" style="padding-left: 0px">
                {% include "app/_searchbox.njk" %}
            </div>
        </div>
        <div class="ontario-column ontario-padding-top-24-!">
            <hr>
        </div>
    </div>

    <div class="ontario-row maincontent__container accordion-and-search">
        <div class="ontario-column ontario-large-4 ontario-large-push-8">
            {% include "app/_accordion.njk" %}
        </div>
        <div class="ontario-column search-output ontario-large-8 ontario-large-pull-4">
            <div id="search-programs-and-services" name="search-programs-and-services" class="show-default-content hide-csv-content">
                {# CSV Content #}
                <!-- csv output for search input-->
                <div id="csv-content" x-init="doSearch()">
                    {% include "app/_searchresults.njk" %}
                    <!-- Include the search results here -->
                </div>
                <!-- / csv output for search input-->
            </div>
        </div>
    </div>
</div>
