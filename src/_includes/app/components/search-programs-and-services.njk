{% set page_lang = "en" %}
{% if lang %}
    {% set page_lang = lang %}
{% endif %}

<div class="ontario-row maincontent__container ontario-padding-top-48-!">
    <div class="ontario-column ontario-small-12">
        <h2>{{ 'seniors.programsAndServicesComponent.title' | localeString }}</h2>
         <div class="ontario-column ontario-small-12 ontario-medium-5 ontario-large-4">
        {% include "app/searchbox.njk" %}
        </div>
    </div>
</div>

<div class="ontario-row maincontent__container ontario-padding-top-24-!">
    <div class="ontario-column ontario-medium-5 ontario-large-4">
        <div id="filter-progams-and-services" class="ontario-form-group">
            <fieldset class="ontario-fieldset">
                <legend class="ontario-fieldset__legend">{{ 'seniors.programsAndServicesComponent.filter' | localeString | safe }}</legend>
                <div class="ontario-checkboxes">
                    <!-- filters -->
                    {% for tag in app.progamsServicesFromCSV.tags %}
                    {% if tag != '' %}
                    <div class="ontario-checkboxes__item">
                        <input class="ontario-checkboxes__input" id="{{ tag }}" name="options" type="checkbox" value="{{ tag }}">
                        <label class="ontario-checkboxes__label" for="{{ tag }}">{{ tag | safe }}</label>
                    </div>
                    {% endif %}
                    {% endfor %}
                    <!-- / filters -->
                </div>
            </fieldset>
        </div>
    </div>
    <div class="ontario-column ontario-medium-7 ontario-large-8">
        <div id="search-progams-and-services" name="search-progams-and-services" class="show-default-content hide-csv-content">
            <div class="default-content">
                <!-- default content -->
                {{ 'seniors.programsAndServicesComponent.content' | localeString | safe }}
                <h3>{{ 'seniors.programsAndServicesComponent.topResources' | localeString }}</h3>
                <ul>
                {% for resource in topResources %}
                    <li>{{ resource | safe }}</li>
                {% endfor %}
                </ul>
                <!-- / default content -->
            </div>

            <!-- csv output for search input-->
            <div class="csv-content" id="csv-content" x-data="search" x-init="doSearch()">
                <div x-show="results.length > 0" class="csv-content-container">
                    <div x-for="item in results">
                        <h3 x-text="item['Internal/External']"></h3>
                        <p>
                            <a :href="item['Resource URL']" x-text="item['Resource title']"></a>
                            <br>
                            <span x-text="item['Category'] + ', ' + item['Sub Category']"></span>
                        </p>
                    </div>
                </div>
                <div x-show="results.length === 0">
                    <p>{{ 'seniors.programsAndServicesComponent.noResults' | localeString | safe }}</p>
                </div>
            </div>
            <!-- / csv output for search input-->
        </div>
    </div>
</div>
