<div class="ontario-row maincontent__container">
    <div class="ontario-column ontario-small-12">
        <h2>{{ "msaasearch.title" | localeString }}</h2>

        <!-- Search Results -->
        <div x-data="searchResults">
            <template x-for="result in results">
                <div>
                    <h3 x-text="result['Resource title']"></h3>
                    <a x-bind:href="result['Resource URL']" target="_blank">Read more</a>
                    <!-- Add more fields as required -->
                </div>
            </template>
        </div>
    </div>
</div>

<script>
    // Assume we import the data from `progamsServicesFromCSV.js` as `seniorsContent`
    document.addEventListener('alpine:init', () => {
        Alpine.data('searchResults', () => ({
            results: [],
            search(query) {
                // Define Fuse.js search options
                let options = {
                    keys: [
                        'Resource title',
                        'Government supports/external',
                        'Tag 1',
                        'Tag 2',
                        'Tag 3',
                        'Tag 4',
                        'Priority'
                    ],
                };

                // Instantiate Fuse.js object with the seniorsContent data and search options
                let fuse = new Fuse(seniorsContent, options);

                // Perform the search using the query
                let searchResults = fuse.search(query);

                // Update the results array with the search results
                this.results = searchResults.map(item => ({
                    title: item.item['Resource title'],
                    description: item.item['Government supports/external'], // Adjust as needed
                    link: item.item['Resource URL']
                }));
            }
        }));
    });
</script>

